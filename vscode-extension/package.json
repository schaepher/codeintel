{
  "name": "codeintel",
  "displayName": "codeintel",
  "description": "Go 代码库智能查询——Activity Bar 查询视图/调用链/时序图/符号详情/影响分析/增量更新索引",
  "version": "0.1.0",
  "publisher": "schaepher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeintel.querySymbol",
    "onCommand:codeintel.querySymbolAt",
    "onCommand:codeintel.impact",
    "onCommand:codeintel.updateIndex",
    "onCommand:codeintel.generateSequence",
    "onView:codeintel.results",
    "onLanguage:go"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeintel.querySymbol",
        "title": "codeintel: 查询符号（详情/调用者/被调用者）"
      },
      {
        "command": "codeintel.impact",
        "title": "codeintel: 影响分析（改前预判）"
      },
      {
        "command": "codeintel.updateIndex",
        "title": "codeintel: 增量更新索引"
      },
      {
        "command": "codeintel.querySymbolAt",
        "title": "codeintel: 查询光标处符号"
      },
      {
        "command": "codeintel.generateSequence",
        "title": "codeintel: 生成调用时序图",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codeintel.refreshResults",
        "title": "codeintel: 刷新查询结果",
        "icon": "$(refresh)"
      },
      {
        "command": "codeintel.openResult",
        "title": "codeintel: 跳转到定义"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeintel",
          "title": "codeintel",
          "icon": "media/codeintel.svg"
        }
      ]
    },
    "views": {
      "codeintel": [
        {
          "id": "codeintel.results",
          "name": "查询结果"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeintel.generateSequence",
          "when": "view == codeintel.results",
          "group": "navigation@1"
        },
        {
          "command": "codeintel.refreshResults",
          "when": "view == codeintel.results",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "codeintel",
      "properties": {
        "codeintel.binaryPath": {
          "type": "string",
          "default": "codeintel",
          "description": "codeintel 可执行文件路径（PATH 中或绝对路径；安装见 https://github.com/schaepher/codeintel#安装）"
        },
        "codeintel.repoPath": {
          "type": "string",
          "default": "",
          "description": "目标仓库根目录（空 = 当前工作区根目录；须已 codeintel init）"
        },
        "codeintel.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "保存 .go 文件后自动增量更新索引（防抖 2s；#234 索引自动更新闭环）"
        },
        "codeintel.callChainDepth": {
          "type": "number",
          "default": 10,
          "description": "调用链树/时序图展开深度（层）"
        },
        "codeintel.maxTreeNodes": {
          "type": "number",
          "default": 100,
          "description": "每棵调用链树最多展示的节点数（防止大图卡顿侧栏）"
        }
      }
    }
  }
}
